# Copy to `.env` (git-ignored) and adjust as needed.

# Local development — Postgres in Docker, published on :5433 (spec-3 § 1.2)
DATABASE_URL="postgresql://vecta:vecta@localhost:5433/vecta"

# "development" | "test" | "production"
NODE_ENV="development"

# Comma-separated key[=value] pairs (spec-3 § 3.7), e.g. "dashboard=on,insights=off".
# Rejected when NODE_ENV=production.
VECTA_FLAGS=""

# Fastify
PORT="3001"
HOST="0.0.0.0"

# Origins allowed to send cross-origin requests in development.
CORS_ORIGINS="http://localhost:5173"

# Optional: separate database used by the data-layer integration tests.
# TEST_DATABASE_URL="postgresql://vecta:vecta@localhost:5433/vecta_test"