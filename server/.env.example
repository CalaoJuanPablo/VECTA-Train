# Copy to `.env` (git-ignored) and adjust as needed.

# Local development — Postgres in Docker, published on :5433.
DATABASE_URL="postgresql://vecta:vecta@localhost:5433/vecta"

# "development" | "test" | "production"
NODE_ENV="development"

# Fastify
PORT="3001"
HOST="0.0.0.0"

# Comma-separated origins allowed to send cross-origin requests.
CORS_ORIGINS="http://localhost:5173"
