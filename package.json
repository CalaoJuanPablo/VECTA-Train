{
  "name": "vecta-train",
  "private": true,
  "type": "module",
  "engines": {
    "node": ">=24"
  },
  "packageManager": "pnpm@12.15.0",
  "scripts": {
    "dev": "pnpm --parallel --filter server --filter client dev",
    "build": "pnpm -r build",
    "test": "pnpm -r test",
    "typecheck": "pnpm -r typecheck",
    "lint": "biome check . && depcruise --config .dependency-cruiser.js server/src client/src && node scripts/check-ts-extensions.mjs",
    "lint:imports": "node scripts/check-ts-extensions.mjs",
    "format": "biome format --write .",
    "db:migrate": "pnpm --filter server db:migrate",
    "db:generate": "pnpm --filter server db:generate"
  },
  "devDependencies": {
    "@biomejs/biome": "2.6.2",
    "@swc/core": "^1.16.18",
    "dependency-cruiser": "18.7.0",
    "typescript": "7.0.2"
  }
}
